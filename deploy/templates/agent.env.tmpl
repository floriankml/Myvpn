# DeutschlandVPN Agent – Konfiguration (root:dvpn-agent 0640)
DVPN_AGENT_INTERFACE=${WG_IF}
DVPN_AGENT_SOCKET=/run/dvpn-agent/agent.sock
DVPN_AGENT_SOCKET_GROUP=dvpn
DVPN_AGENT_STATE_FILE=/var/lib/dvpn-agent/peers.json
DVPN_AGENT_SUBNET_V4=${SUBNET_V4}
DVPN_AGENT_SUBNET_V6=${SUBNET_V6}
DVPN_AGENT_SERVER_ADDRESSES=${AGENT_SERVER_ADDRESSES}
DVPN_AGENT_ALLOWED_USERS=dvpn
DVPN_AGENT_WG_BINARY=/usr/bin/wg
