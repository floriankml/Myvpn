# DeutschlandVPN Backend – Konfiguration (root:dvpn 0640)
# Enthält KEINE Passwörter. Änderungen: systemctl restart dvpn-backend
DVPN_DATABASE_URL=sqlite:///${STATE_DIR}/dvpn.db
DVPN_AGENT_SOCKET=/run/dvpn-agent/agent.sock
DVPN_SERVER_ID=de-1
DVPN_SERVER_NAME=${SERVER_NAME}
DVPN_SERVER_LOCATION=${LOCATION}
DVPN_SERVER_PROVIDER=${PROVIDER}
DVPN_ENDPOINT_HOST=${ENDPOINT}
DVPN_ENDPOINT_PORT=${WG_PORT}
DVPN_PUBLIC_IPV4=${PUBLIC_IPV4}
DVPN_PUBLIC_IPV6=${PUBLIC_IPV6}
DVPN_SUBNET_V4=${SUBNET_V4}
DVPN_SUBNET_V6=${SUBNET_V6}
DVPN_IPV6_EGRESS=${IPV6_EGRESS}
DVPN_COOKIE_SECURE=${COOKIE_SECURE}
DVPN_ALLOWED_ORIGINS=${ALLOWED_ORIGINS}
DVPN_STATIC_DIR=${INSTALL_DIR}/src/frontend/dist
DVPN_MAX_DEVICES_PER_USER=5
DVPN_SESSION_TTL_HOURS=12
DVPN_REVOKED_RETENTION_DAYS=30
DVPN_RECONCILE_INTERVAL=60
DVPN_WEB_HOST=${SERVER_V4}
DVPN_WEB_PORT=${WEB_PORT}
DVPN_FORWARDED_ALLOW_IPS=${FORWARDED_ALLOW}
